#!/bin/bash

ARCH=`uname`

case "${ARCH}" in
	"Darwin"	)	export ARCH=MAC
					export DEBUG="-g -Wall"
#					export DEBUG="-O"
					export PQLCFLAGS="-unroll2"
					export PQLLFLAGS="-lm -all_load";;
	"Linux" | "FreeBSD"		)	export ARCH=LINUX
          export DEBUG="-g -Wall"
          export PQLCFLAGS="$(pkg-config --cflags gtk+-2.0 glib-2.0) -I/usr/include/tirpc"
          export PQLLFLAGS="-lm $(pkg-config --libs gtk+-2.0 glib-2.0) -ltirpc -lnsl";;
#					export DEBUG="-O3"
#					HARDWARE=`uname -i`
#					case "${HARDWARE}" in
#						"i386"	)
#							export PQLCFLAGS="-march=pentiumpro";;
#						"x86_64" | "ia64"	)
#							export PQLCFLAGS="-march=x86_64";;
#					esac
	"SunOS"	)	export ARCH=SOLARIS
#					export DEBUG="-g -Wall"
					export DEBUG="-O2"
					export PQLCFLAGS="-unroll2 -mcpu=v9"
					export PQLLFLAGS="-lm -lnsl"
					export LD_RUN_PATH=/opt/passcal/other/lib;;
esac


PQLHOME=`pwd`
export PQLLIB=${PQLHOME}/lib/${ARCH}
export PQLINC=${PQLHOME}/include
export PQLBIN=${PQLHOME}/bin/${ARCH}
