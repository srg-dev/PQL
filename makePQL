#!/bin/bash

# verify the compilation and installation
exes="pql"

echo
echo "Verifying PQL compilation:"
echo

cd $PQLBIN
failed=FALSE
for exe in $exes ; do

	if [ ! -e $exe ] ; then
		echo "Missing executable file '$exe'."
		echo
		failed=TRUE
	fi

done

cd $PQLLIB
if [ "${failed}" = "FALSE" ] ; then
	echo "PQL exe's Compiled and Installed Successfully..."
	echo
else
	libs="libdata.a libmseed.a libutils.a libvfbb.a libgdbm.a libdbl.a"
	for lib in $libs ; do
		if [ ! -e $lib ] ; then
			echo "Required PQL Library '$lib' does not exist."
			echo "	Compilation most likely failed, please investigate..."
		fi
	done
	
	echo
	echo "PQL Verification FAILED!"
fi
fi

cd $PQLHOME

